{
  "name": "@postio/cli",
  "version": "0.1.1",
  "description": "Postio command-line interface — UK address, email, and phone validation from your terminal. `npx postio …`.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postio": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://postio.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postio-uk/postio-integrations.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/postio-uk/postio-integrations/issues"
  },
  "keywords": [
    "postio",
    "cli",
    "uk",
    "address",
    "postcode",
    "udprn",
    "email-validation",
    "phone-validation",
    "paf",
    "royal-mail",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@postio/node": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
