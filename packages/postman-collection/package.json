{
  "name": "@postio/postman-collection",
  "version": "1.0.2",
  "description": "Postio API as a Postman v2.1 collection, generated from @postio/openapi.",
  "license": "MIT",
  "main": "./dist/postio.postman_collection.json",
  "exports": {
    ".": "./dist/postio.postman_collection.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "mkdir -p dist && openapi2postmanv2 -s ./node_modules/@postio/openapi/openapi.json -o dist/postio.postman_collection.json -p",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://postio.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postio-uk/postio-integrations.git",
    "directory": "packages/postman-collection"
  },
  "bugs": {
    "url": "https://github.com/postio-uk/postio-integrations/issues"
  },
  "keywords": [
    "postio",
    "postman",
    "postman-collection",
    "openapi",
    "uk",
    "address",
    "postcode",
    "email",
    "phone",
    "validation"
  ],
  "devDependencies": {
    "@postio/openapi": "1.0.2",
    "openapi-to-postmanv2": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
