{
  "name": "@postio/mcp",
  "version": "0.1.2",
  "description": "Model Context Protocol server for Postio — UK address, email, and phone validation as tools for Claude, Cursor, Windsurf, Zed, etc.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "postio-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://postio.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postio-uk/postio-integrations.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/postio-uk/postio-integrations/issues"
  },
  "keywords": [
    "postio",
    "uk",
    "address",
    "postcode",
    "validation",
    "address-validation",
    "paf",
    "royal-mail",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf",
    "ai-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@postio/core": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
