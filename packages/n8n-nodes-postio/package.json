{
  "name": "@postio/n8n-nodes-postio",
  "version": "0.1.0",
  "description": "n8n community node for Postio — UK address lookup, postcode autocomplete, email validation and phone validation on official Royal Mail PAF data.",
  "license": "MIT",
  "homepage": "https://postio.co.uk/integrations",
  "keywords": [
    "n8n-community-node-package",
    "postio",
    "uk address api",
    "postcode lookup",
    "address validation",
    "email validation",
    "phone validation",
    "royal mail paf"
  ],
  "author": {
    "name": "Postio",
    "email": "admin@postio.co.uk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postio-uk/postio-integrations.git",
    "directory": "packages/n8n-nodes-postio"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PostioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Postio/Postio.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "eslint": "^9.39.4",
    "n8n-workflow": "*",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
